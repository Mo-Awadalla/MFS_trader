    "negative_net_pressure": "SPXU",
    "exact_zero": "CASH",
    "magnitude_threshold": null
  },
  "execution": {
    "position": "one long fractional ETF, maximum gross exposure 100% of current cash",
    "entry": "recorded ARCX.PILLAR 15:31 ask",
